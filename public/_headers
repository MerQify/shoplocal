# Workers Static Assets response headers (#1624). OpenNext copies public/ into
# .open-next/assets, where Cloudflare reads this file; it is not itself served.
#
# Next.js content-hashes every file under /_next/static, so a file at a given URL
# can never change (a new build produces new names). Without this rule they were
# served `public, max-age=14400, must-revalidate`, and every returning visitor
# re-checked ~50 files after four hours. Pages are NOT covered: they are
# personalised and stay `no-store`.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
